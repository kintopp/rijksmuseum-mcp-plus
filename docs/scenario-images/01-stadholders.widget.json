{"title":"stadholder_imagery_by_decade_and_medium","loading_messages":["Sorting prints from medals","Shading four lifetimes","Stacking the decades"],"widget_code":"<h2 class=\"sr-only\">Small multiples of Rijksmuseum works depicting the stadholders Maurits, Frederik Hendrik, Willem II and Willem III per decade, stacked by medium, with lifetime and term of office shaded and posthumous material hatched.</h2>\n<div id=\"legend\" style=\"display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--text-secondary);margin:0 0 6px;\"></div>\n<div id=\"panels\"></div>\n<p style=\"font-size:12px;color:var(--text-muted);margin:8px 0 0;line-height:1.5;\">Rijksmuseum works tagged with each stadholder's authority record, binned by earliest creation date. Each panel has its own y-scale. Two isolated works dated after 1960 are omitted.</p>\n<script>\nconst M=['print','painting','drawing','medal','other'];\nconst LBL={print:'Prints',painting:'Paintings and miniatures',drawing:'Drawings',medal:'Medals and jetons',other:'Other (books, text sheets, photos, objects)'};\nconst dark=matchMedia('(prefers-color-scheme: dark)').matches||document.documentElement.dataset.mode==='dark';\nconst COL={print:dark?'#3987e5':'#2a78d6',painting:dark?'#d95926':'#eb6834',drawing:dark?'#199e70':'#1baf7a',medal:dark?'#c98500':'#eda100',other:'#888780'};\nconst P=[\n{name:'Maurits',life:[1567,1625],office:[1585,1625],officeLbl:'stadholder 1585–1625',\ntotal:{1550:1,1560:4,1570:3,1580:11,1590:547,1600:308,1610:303,1620:181,1630:11,1640:33,1650:19,1660:20,1670:19,1680:9,1690:16,1700:12,1710:7,1720:19,1730:12,1740:21,1750:13,1760:1,1770:15,1780:23,1790:9,1800:18,1810:6,1820:9,1830:12,1840:14,1850:67,1860:11,1870:12,1880:7,1890:4,1920:1,1930:1},\nprint:{1550:1,1570:1,1580:7,1590:475,1600:256,1610:238,1620:151,1630:5,1640:33,1650:18,1660:19,1670:16,1680:7,1690:15,1700:11,1710:1,1720:19,1730:9,1740:19,1750:12,1760:1,1770:12,1780:19,1790:9,1800:17,1810:6,1820:9,1830:11,1840:13,1850:56,1860:5,1870:10,1880:2,1890:4,1920:1,1930:1},\npainting:{1600:4,1610:8,1620:5,1630:4,1660:1,1870:1},\ndrawing:{1580:1,1590:11,1600:3,1610:2,1620:4,1630:2,1650:3,1670:1,1680:1,1700:1,1710:3,1730:1,1740:1,1750:1,1770:3,1780:3,1840:1,1850:3},\nmedal:{1580:1,1590:57,1600:27,1610:9,1620:8,1650:1,1670:1},\nnotes:[[1590,'incl. c. 420 drill-manual plates']]},\n{name:'Frederik Hendrik',life:[1584,1647],office:[1625,1647],officeLbl:'stadholder 1625–47',\ntotal:{1570:1,1580:1,1590:3,1600:44,1610:29,1620:156,1630:170,1640:227,1650:199,1660:11,1670:11,1680:7,1690:5,1700:4,1720:17,1730:30,1740:15,1750:11,1760:4,1770:3,1780:16,1800:17,1810:2,1820:2,1830:11,1840:11,1850:51,1860:10,1870:12,1880:3,1890:6,1900:4,1910:1,1920:1,1930:1,1940:1},\nprint:{1570:1,1580:1,1590:3,1600:43,1610:21,1620:126,1630:126,1640:189,1650:115,1660:10,1670:9,1680:5,1690:4,1700:3,1720:16,1730:28,1740:13,1750:9,1760:4,1770:2,1780:11,1800:17,1810:2,1820:2,1830:9,1840:9,1850:28,1860:3,1870:11,1890:5,1920:1,1930:1},\npainting:{1610:5,1620:5,1630:7,1640:6,1650:3,1660:1,1670:1},\ndrawing:{1610:2,1620:2,1630:1,1640:1,1650:6,1680:1,1690:1,1740:1,1770:1,1780:4,1860:2,1870:1},\nmedal:{1620:5,1630:15,1640:4,1650:1,1670:1,1850:1},\nnotes:[[1650,'funeral procession book, 1651']]},\n{name:'Willem II',life:[1626,1650],office:[1647,1650],officeLbl:'stadholder 1647–50',\ntotal:{1620:7,1630:9,1640:70,1650:80,1660:8,1670:12,1680:4,1690:2,1700:2,1710:5,1720:27,1730:8,1740:19,1750:12,1760:1,1770:6,1780:7,1790:1,1800:11,1810:3,1820:4,1830:1,1840:3,1850:12,1860:6,1870:5,1880:2,1890:4,1920:1,1930:1,1950:1},\nprint:{1620:6,1630:9,1640:54,1650:44,1660:7,1670:11,1680:2,1690:2,1700:1,1710:3,1720:27,1730:5,1740:19,1750:11,1760:1,1770:4,1780:7,1800:10,1810:3,1820:4,1830:1,1840:3,1850:9,1860:2,1870:4,1890:4,1920:1,1930:1},\npainting:{1640:6,1650:5,1660:1},\ndrawing:{1620:1,1650:4,1680:1,1700:1,1710:1,1730:1,1750:1,1770:1,1860:1,1870:1},\nmedal:{1640:4,1650:22,1670:1},\nnotes:[[1650,'1650 blockade of Amsterdam']]},\n{name:'Willem III',life:[1650,1702],office:[1672,1702],officeLbl:'stadholder 1672–1702 (king from 1689)',\ntotal:{1590:1,1600:2,1620:5,1630:8,1640:3,1650:37,1660:44,1670:320,1680:410,1690:457,1700:69,1710:11,1720:27,1730:16,1740:21,1750:10,1760:4,1770:10,1780:16,1790:4,1800:17,1810:2,1820:8,1830:6,1840:6,1850:30,1860:5,1870:10,1880:3,1890:5,1900:3,1910:1,1920:1,1930:1},\nprint:{1590:1,1620:4,1630:8,1640:3,1650:17,1660:37,1670:240,1680:332,1690:314,1700:56,1710:11,1720:27,1730:12,1740:21,1750:9,1760:4,1770:7,1780:12,1790:3,1800:15,1810:2,1820:6,1830:6,1840:6,1850:22,1860:4,1870:9,1880:1,1890:4,1900:1,1920:1,1930:1},\npainting:{1600:1,1650:2,1660:3,1670:4,1680:4,1690:4,1700:1},\ndrawing:{1670:28,1680:3,1690:12,1730:1,1770:2,1780:3,1790:1,1820:1},\nmedal:{1650:6,1670:25,1680:39,1690:88,1700:8,1780:1,1800:2},\nnotes:[[1690,'medals peak in kingship']]}\n];\nconst lg=document.getElementById('legend');\nconst sw=(s,t)=>`<span style=\"display:flex;align-items:center;gap:5px;\">${s}${t}</span>`;\nlg.innerHTML=M.map(m=>sw(`<span style=\"width:10px;height:10px;border-radius:2px;background:${COL[m]}\"></span>`,LBL[m])).join('')\n+sw('<span style=\"width:14px;height:10px;background:rgba(136,135,128,0.18)\"></span>','Lifetime')\n+sw('<span style=\"width:14px;height:10px;background:rgba(127,119,221,0.30)\"></span>','In office')\n+sw('<svg width=\"14\" height=\"10\"><rect width=\"14\" height=\"10\" fill=\"url(#hatchL)\"/></svg>','Later historical material (10+ years after death)');\nconst W=680,H=150,L=44,R=8,T=18,B=22,X0=1550,X1=1960,pw=W-L-R,ph=H-T-B;\nconst x=y=>L+(y-X0)/(X1-X0)*pw;\nconst ink=dark?'#c3c2b7':'#52514e',muted='#898781',grid=dark?'#2c2c2a':'#e1e0d9',hatch=dark?'rgba(195,194,183,0.28)':'rgba(82,81,78,0.22)',bg=dark?'#1a1a19':'#ffffff';\nlet defs=`<svg width=\"0\" height=\"0\" style=\"position:absolute\"><defs><pattern id=\"hatchL\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"${hatch}\" stroke-width=\"2\"/></pattern></defs></svg>`;\nlet out=defs;\nP.forEach(p=>{\n const vals=Object.values(p.total);const mx=Math.max(...vals);\n const step=mx>300?100:mx>100?50:20;const ymax=Math.ceil(mx/step)*step;\n const y=v=>T+ph-v/ymax*ph;\n let s=`<svg viewBox=\"0 0 ${W} ${H}\" width=\"100%\" role=\"img\" aria-label=\"${p.name}: works per decade by medium\"><title>${p.name}</title>`;\n s+=`<rect x=\"${x(p.life[0])}\" y=\"${T}\" width=\"${x(p.life[1])-x(p.life[0])}\" height=\"${ph}\" fill=\"rgba(136,135,128,0.18)\"/>`;\n s+=`<rect x=\"${x(p.office[0])}\" y=\"${T}\" width=\"${Math.max(2,x(p.office[1])-x(p.office[0]))}\" height=\"${ph}\" fill=\"rgba(127,119,221,0.30)\"/>`;\n const lat=p.life[1]+10;\n s+=`<rect x=\"${x(lat)}\" y=\"${T}\" width=\"${x(X1)-x(lat)}\" height=\"${ph}\" fill=\"url(#hatchL)\"/>`;\n for(let g=step;g<=ymax;g+=step){s+=`<line x1=\"${L}\" x2=\"${W-R}\" y1=\"${y(g)}\" y2=\"${y(g)}\" stroke=\"${grid}\" stroke-width=\"1\"/><text x=\"${L-6}\" y=\"${y(g)+4}\" text-anchor=\"end\" font-size=\"11\" fill=\"${muted}\">${g}</text>`;}\n s+=`<line x1=\"${L}\" x2=\"${W-R}\" y1=\"${T+ph}\" y2=\"${T+ph}\" stroke=\"${dark?'#383835':'#c3c2b7'}\"/>`;\n s+=`<line x1=\"${x(p.life[1])}\" x2=\"${x(p.life[1])}\" y1=\"${T}\" y2=\"${T+ph}\" stroke=\"${ink}\" stroke-dasharray=\"3 3\" stroke-width=\"1\"/>`;\n for(let d=X0;d<X1;d+=10){\n  const tot=p.total[d]||0;if(!tot)continue;\n  let acc=0;const bx=x(d)+1.5,bw=x(d+10)-x(d)-3;\n  const parts={};let known=0;['print','painting','drawing','medal'].forEach(m=>{parts[m]=p[m][d]||0;known+=parts[m];});\n  parts.other=Math.max(0,tot-known);\n  const sum=known+parts.other;const scale=tot/sum;\n  const tip=`${p.name}, ${d}s: ${tot} works — `+M.filter(m=>parts[m]).map(m=>`${LBL[m].split(' (')[0].toLowerCase()} ${parts[m]}`).join(', ');\n  s+=`<g><title>${tip}</title>`;\n  M.forEach(m=>{const v=parts[m]*scale;if(!v)return;const y0=y(acc),y1=y(acc+v);s+=`<rect x=\"${bx}\" y=\"${y1}\" width=\"${bw}\" height=\"${Math.max(0.6,y0-y1-(acc>0?0.8:0))}\" fill=\"${COL[m]}\"/>`;acc+=v;});\n  s+=`</g>`;\n }\n for(let d=1550;d<=1950;d+=50){s+=`<text x=\"${x(d)}\" y=\"${H-6}\" text-anchor=\"middle\" font-size=\"11\" fill=\"${muted}\">${d}</text>`;}\n s+=`<text x=\"${L}\" y=\"12\" font-size=\"13\" font-weight=\"500\" fill=\"${dark?'#f0efec':'#0b0b0b'}\">${p.name}</text>`;\n s+=`<text x=\"${L+(p.name.length*7.6)+10}\" y=\"12\" font-size=\"11\" fill=\"${muted}\">lived ${p.life[0]}–${p.life[1]} · ${p.officeLbl}</text>`;\n s+=`<text x=\"${x(lat)+4}\" y=\"${T+11}\" font-size=\"11\" fill=\"${muted}\">later historical record</text>`;\n p.notes.forEach(([d,t])=>{const tot=p.total[d];const tx=x(d+10)+4;const ty=Math.max(T+24,y(tot)+10);s+=`<text x=\"${tx}\" y=\"${ty}\" font-size=\"11\" fill=\"${ink}\">← ${t}</text>`;});\n s+=`</svg>`;\n out+=`<div style=\"margin:0 0 10px;\">${s}</div>`;\n});\ndocument.getElementById('panels').innerHTML=out;\n</script>"}