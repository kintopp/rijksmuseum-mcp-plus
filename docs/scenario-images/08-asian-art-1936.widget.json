{"loading_messages":["Tracing 40 objects","Routing bequests and purchases","Colouring by region"],"title":"vvak_1936_exhibition_objects_owner_to_museum_sankey","widget_code":"<h2 class=\"sr-only\">Flow diagram of 40 Rijksmuseum objects cited in the 1936 Amsterdam exhibition of Asian art, from their probable 1936 owners through the route by which they left those owners to their arrival at the museum, coloured by region of origin. 38 arrive as loans from the Royal Asian Art Society in 1972; 2 are museum property.</h2>\n<div id=\"lg\" style=\"display:flex;flex-wrap:wrap;gap:14px;margin:0 0 10px;font-size:12px;color:var(--text-secondary);\"></div>\n<div style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--text-muted);margin:0 0 4px;padding:0 4px;\"><span>Probable owner, 1936</span><span>Route out of private hands</span><span>Arrival at the museum</span></div>\n<div id=\"sk\" style=\"width:100%;\"></div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/d3-sankey@0.12.3/dist/d3-sankey.min.js\"></script>\n<script>\nconst mode=document.documentElement.dataset.mode;\nconst dark=mode?mode==='dark':matchMedia('(prefers-color-scheme: dark)').matches;\nconst R=[[\"China\",dark?\"#3987e5\":\"#2a78d6\"],[\"Japan\",dark?\"#d95926\":\"#eb6834\"],[\"Korea\",dark?\"#199e70\":\"#1baf7a\"],[\"South Asia\",dark?\"#c98500\":\"#eda100\"],[\"Southeast Asia\",dark?\"#d55181\":\"#e87ba4\"],[\"Tibet\",dark?\"#9085e9\":\"#6250d6\"]];\nconst col=Object.fromEntries(R);\nconst tot={China:13,Japan:13,Korea:3,\"South Asia\":4,\"Southeast Asia\":6,Tibet:1};\ndocument.getElementById('lg').innerHTML=R.map(([n,c])=>`<span style=\"display:flex;align-items:center;gap:5px;\"><span style=\"width:10px;height:10px;border-radius:2px;background:${c}\"></span>${n} ${tot[n]}</span>`).join('');\nconst N=[\"Westendorp, Amsterdam\",\"Verburgt-Kramers, The Hague\",\"Heldring\",\"Wurfbain\",\"Loudon\",\"R.H. May, Zeist\",\"Unclear / dealer\",\"Gift to VVAK, 1938–55\",\"Bequest to VVAK, 1954\",\"Bequest to VVAK, 1968–69\",\"Bought by VVAK, 1937–57\",\"Via J. Post, 1979\",\"Route unrecorded\",\"On loan from KVVAK, 1972\",\"Rijksmuseum property\"];\nconst L=[[0,7,\"Japan\",2],[0,9,\"Japan\",10],[0,9,\"China\",4],[0,9,\"Korea\",2],[0,9,\"South Asia\",1],[1,9,\"China\",4],[1,9,\"South Asia\",2],[1,9,\"Southeast Asia\",2],[1,9,\"Japan\",1],[1,7,\"Tibet\",1],[2,8,\"China\",1],[2,8,\"Korea\",1],[3,10,\"South Asia\",1],[3,10,\"Southeast Asia\",1],[4,10,\"Southeast Asia\",2],[6,10,\"Southeast Asia\",1],[6,10,\"China\",2],[6,12,\"China\",1],[5,11,\"China\",1],[7,13,\"Japan\",2],[7,13,\"Tibet\",1],[8,13,\"China\",1],[8,13,\"Korea\",1],[9,13,\"Japan\",11],[9,13,\"China\",8],[9,13,\"Korea\",2],[9,13,\"South Asia\",3],[9,13,\"Southeast Asia\",2],[10,13,\"China\",2],[10,13,\"South Asia\",1],[10,13,\"Southeast Asia\",4],[12,14,\"China\",1],[11,14,\"China\",1]];\nconst W=680,H=470;\nconst svg=d3.select('#sk').append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%').attr('role','img').attr('aria-label','Sankey diagram of object flows by region');\nconst sk=d3.sankey().nodeWidth(10).nodePadding(14).nodeSort(null).linkSort(null).extent([[168,6],[528,H-6]]);\nconst g=sk({nodes:N.map(n=>({name:n})),links:L.map(([s,t,r,v])=>({source:s,target:t,region:r,value:v}))});\nsvg.append('g').attr('fill','none').selectAll('path').data(g.links).join('path')\n .attr('d',d3.sankeyLinkHorizontal()).attr('stroke',d=>col[d.region]).attr('stroke-opacity',0.55).attr('stroke-width',d=>Math.max(1,d.width))\n .on('mouseover',function(){d3.select(this).attr('stroke-opacity',0.9)}).on('mouseout',function(){d3.select(this).attr('stroke-opacity',0.55)})\n .append('title').text(d=>`${d.source.name} → ${d.target.name}\\n${d.region}: ${d.value}`);\nsvg.append('g').selectAll('rect').data(g.nodes).join('rect')\n .attr('x',d=>d.x0).attr('y',d=>d.y0).attr('width',d=>d.x1-d.x0).attr('height',d=>Math.max(2,d.y1-d.y0)).attr('rx',2)\n .attr('fill',dark?'#b4b2a9':'#5f5e5a');\nsvg.append('g').selectAll('text').data(g.nodes).join('text')\n .attr('x',d=>d.depth===0?d.x0-6:d.x1+6).attr('y',d=>(d.y0+d.y1)/2).attr('dy','0.35em')\n .attr('text-anchor',d=>d.depth===0?'end':'start').attr('font-size',12)\n .style('fill','var(--text-primary)').style('paint-order','stroke').style('stroke','var(--surface-0)').style('stroke-width','3px')\n .text(d=>`${d.name} (${d.value})`);\n</script>"}